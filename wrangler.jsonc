{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-worker-reverse-searching",
  "main": "src/router.py",
  "compatibility_date": "2025-09-04",
  "compatibility_flags": [
    "python_workers"
  ],
  "observability": {
    "enabled": true
  },
  "vars":{
    "PATH_DEPTH": 7
  },
  "services": [
      {
          "binding": "RPC",
          "service": "bridge-for-fluffle",
          "entrypoint": "RpcService"
      }
  ],
  	"kv_namespaces": [
		{
			"binding": "KEYS",
			"id": "68e27c55cdf34d9791ddf245f1d21bcd"
		}
  	]
}