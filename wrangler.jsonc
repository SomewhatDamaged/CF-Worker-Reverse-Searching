{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-worker-reverse-searching",
  "main": "src/router.py",
  "compatibility_date": "2025-09-04",
  "compatibility_flags": [
    "python_workers"
  ],
  "observability": {
    "enabled": true
  },
  "vars":{
    "PATH_DEPTH": 7
  },
  "services": [{
    "binding": "FLUFFLE_BRIDGE",
    "service": "cf-worker-reverse-searching-bridge"
  }]
}